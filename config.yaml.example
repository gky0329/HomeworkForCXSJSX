app:
  name: C++ Memory Visualizer
  version: 0.1.0
llm:
  api_base: https://api.deepseek.com
  api_key: your-api-key-here  # or set DEEPSEEK_API_KEY env var
  max_tokens: 4096
  model: deepseek-chat
  provider: deepseek
  temperature: 0.0
  # proxy: http://127.0.0.1:7890  # optional, for users behind a proxy
ui:
  code_font_size: 14
  font_family: JetBrains Mono, Menlo, SF Mono, Courier New, monospace
  font_size: 13
  theme: dark
