app:
  name: "C++ Memory Visualizer"
  version: "0.1.0"

llm:
  provider: deepseek
  api_key: "sk-your-deepseek-api-key-here"
  api_base: "https://api.deepseek.com"
  model: deepseek-chat
  temperature: 0.0
  max_tokens: 4096

ui:
  theme: dark
  font_family: "JetBrains Mono, Consolas, monospace"
  font_size: 13
  code_font_size: 14
